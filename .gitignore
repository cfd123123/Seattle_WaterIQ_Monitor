# =============================================================================
# Public-repo hygiene: keep source + minimal ops docs; exclude local data/artifacts.
# See DEMO.md for HR reviewer workflow and safe push checklist.
# =============================================================================

# --- Local-only notes at repo root (keep docs/screenshots/ for HR demo assets) ---
/docs/*
!/docs/screenshots/
!/docs/screenshots/**

# --- Runtime / fetched data (never commit IV CSVs or feature tables) ---
/ai_service/data/

# --- Secrets and environment ---
.env
.env.*
!.env.example
*.pem
*.key

# --- Python ---
__pycache__/
*.py[cod]
*$py.class
.Python
.venv/
venv/
env/
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/
dist/
build/

# --- Java / Maven (when building from repo root) ---
target/

# --- Node / frontend build output (repo-root perspective) ---
node_modules/
dist/
dist-ssr/

# --- IDE, editor, and OS junk (repo root only; subprojects may have their own) ---
/.vscode/
/.idea/
/.cursor/
*.swp
*.swo
.DS_Store
Thumbs.db

# --- Logs and temp files ---
*.log
logs/
tmp/
temp/
*.tmp
*.bak

# --- Test coverage ---
coverage/
htmlcov/
.coverage
*.cover

# --- Matplotlib font cache (generated locally) ---
ai_service/.mplcache/
ai_service/.mplconfig/

# --- RAG index artifacts (rebuild locally: python -m assistant.rag.indexer --rebuild) ---
ai_service/assistant/rag/store/

# --- Backtest, EDA, tuning JSON, and other experiment outputs ---
ai_service/reports/

# --- Linearity eval plots and JSON (regenerate from scripts) ---
ai_service/linearity_eval/output/
ai_service/models/linearity_eval/output/

# --- Trained model pickles (forecast fits on-the-fly; anomaly has imputation fallback) ---
ai_service/models/*.pkl
ai_service/*.pkl

# --- Internal planning, summaries, implementation notes, interview prep (ai_service) ---
ai_service/plan/
ai_service/docs/rag_copilot_implementation.md
ai_service/docs/assistant_agent_implementation.md
ai_service/docs/assistant_agent.md
ai_service/docs/ai_summary_turbidity.md
ai_service/docs/flow_forecast_pipeline_interview.md
# Keep committed: ai_service/docs/turbidity_operations.md (RAG source; see assistant/config.py)

# --- Optional: trim internal business planning docs from public mirror ---
monitor_business/docs/*-plan.md
monitor_business/docs/TODO.md
monitor_business/docs/bq-notes.md
monitor_business/docs/distributed-system-plan.md
