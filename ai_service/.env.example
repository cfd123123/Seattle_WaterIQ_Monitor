# Copy to .env.local — never commit real keys
ASSISTANT_ENABLED=true
ASSISTANT_LLM_BASE_URL=http://localhost:11434/v1
ASSISTANT_LLM_API_KEY=ollama
ASSISTANT_LLM_MODEL=qwen2.5:3b

# MVP-2 RAG copilot
ASSISTANT_RAG_INDEX_DIR=assistant/rag/store
ASSISTANT_RAG_TOP_K=5
# Intent router + BM25 query rewrite (set false to search with raw question)
ASSISTANT_QUERY_TRANSFORM=true
# ASSISTANT_RAG_REBUILD_KEY=dev-only-secret

# L3 agent
ASSISTANT_MAX_TOOL_ROUNDS=5
